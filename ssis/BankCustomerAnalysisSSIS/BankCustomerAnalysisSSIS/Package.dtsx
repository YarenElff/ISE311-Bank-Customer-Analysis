                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    R.MusteriID,
    R.KategoriID,
    R.TamAd,
    R.SehirAd,
    R.BolgeAd,
    R.Yas,
    S.ServetTRY,
    R.SiraNo
FROM dbo.Stg_MusteriSiralama AS R
INNER JOIN dbo.Stg_MusteriServet AS S
    ON R.MusteriID = S.MusteriID
WHERE R.SiraNo &lt;= 3
ORDER BY
    R.BolgeAd,
    R.KategoriID,
    R.SiraNo,
    R.MusteriID;</property>
